{
 "id": "voice_clock_ring",
 "alias": "Voice Timers and Alarms - Ringing",
 "description": "Rings the room's Echo (VACA's alarm switch, its alarm volume) when timer.<area>_timer finishes or input_datetime.<area>_alarm_time arrives while input_boolean.<area>_alarm is on, by setting input_select.<area>_ringing to Timer or Alarm; the Show card shows the stop/reset or stop/snooze screen from that. Ringing back to Off silences it and puts the screen brightness back; a finished alarm turns itself off. Stops by itself after 10 minutes. Per-room device entities are in the `rooms` variable. Kitchen (the kitchen tablet, 2026-11-10) added: no brightness automation or sleep switch there, so those steps skip. Kitchen moved to Kiosk Satellite 2026-11-21: it rings with a repeating KS announce (room key `ks`), stopped by announce_stop; kitchen voice timers are KS's own and don't come through here. Bedroom moved to Kiosk Satellite 2026-11-21 too (ks_bedroom_echo); an alarm there still turns the sleep sounds off first.",
 "triggers": [
  {
   "trigger": "event",
   "event_type": "timer.finished",
   "event_data": {
    "entity_id": "timer.bedroom_timer"
   },
   "id": "timer",
   "variables": {
    "area": "bedroom"
   }
  },
  {
   "trigger": "time",
   "at": "input_datetime.bedroom_alarm_time",
   "id": "alarm",
   "variables": {
    "area": "bedroom"
   }
  },
  {
   "trigger": "state",
   "entity_id": "input_select.bedroom_ringing",
   "to": "Off",
   "id": "silence",
   "variables": {
    "area": "bedroom"
   }
  },
  {
   "trigger": "state",
   "entity_id": "input_select.bedroom_ringing",
   "to": [
    "Timer",
    "Alarm"
   ],
   "for": {
    "minutes": 10
   },
   "id": "timeout",
   "variables": {
    "area": "bedroom"
   }
  },
  {
   "trigger": "event",
   "event_type": "timer.finished",
   "event_data": {
    "entity_id": "timer.kitchen_timer"
   },
   "id": "timer",
   "variables": {
    "area": "kitchen"
   }
  },
  {
   "trigger": "time",
   "at": "input_datetime.kitchen_alarm_time",
   "id": "alarm",
   "variables": {
    "area": "kitchen"
   }
  },
  {
   "trigger": "state",
   "entity_id": "input_select.kitchen_ringing",
   "to": "Off",
   "id": "silence",
   "variables": {
    "area": "kitchen"
   }
  },
  {
   "trigger": "state",
   "entity_id": "input_select.kitchen_ringing",
   "to": [
    "Timer",
    "Alarm"
   ],
   "for": {
    "minutes": 10
   },
   "id": "timeout",
   "variables": {
    "area": "kitchen"
   }
  }
 ],
 "conditions": [],
 "actions": [
  {
   "variables": {
    "rooms": {
     "bedroom": {
      "alarm_switch": "",
      "screen": "",
      "auto": "",
      "brightness": "",
      "after": "",
      "sleep": "input_boolean.bedroom_night_mode",
      "ks": "ks_bedroom_echo"
     },
     "kitchen": {
      "alarm_switch": "",
      "screen": "",
      "auto": "",
      "brightness": "",
      "after": "",
      "sleep": "",
      "ks": "ks_kitchen_display"
     }
    },
    "r": "{{ rooms[area] }}",
    "ringing": "input_select.{{ area }}_ringing",
    "armed": "input_boolean.{{ area }}_alarm",
    "alarm_time": "input_datetime.{{ area }}_alarm_time"
   }
  },
  {
   "choose": [
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": [
        "timer",
        "alarm"
       ]
      },
      {
       "condition": "template",
       "value_template": "{{ trigger.id == 'timer' or is_state(armed, 'on') }}"
      }
     ],
     "sequence": [
      {
       "action": "input_select.select_option",
       "target": {
        "entity_id": "{{ ringing }}"
       },
       "data": {
        "option": "{{ 'Timer' if trigger.id == 'timer' else 'Alarm' }}"
       }
      },
      {
       "if": [
        {
         "condition": "template",
         "value_template": "{{ r.ks == '' }}"
        }
       ],
       "then": [
        {
         "action": "switch.turn_on",
         "target": {
          "entity_id": "{{ r.screen }}"
         },
         "continue_on_error": true
        },
        {
         "if": [
          {
           "condition": "template",
           "value_template": "{{ is_state(r.auto, 'off') }}"
          }
         ],
         "then": [
          {
           "action": "number.set_value",
           "target": {
            "entity_id": "{{ r.brightness }}"
           },
           "data": {
            "value": 60
           },
           "continue_on_error": true
          }
         ]
        },
        {
         "if": [
          {
           "condition": "template",
           "value_template": "{{ trigger.id == 'alarm' and is_state(r.sleep, 'on') }}"
          }
         ],
         "then": [
          {
           "action": "input_boolean.turn_off",
           "target": {
            "entity_id": "{{ r.sleep }}"
           },
           "continue_on_error": true
          }
         ]
        },
        {
         "action": "switch.turn_on",
         "target": {
          "entity_id": "{{ r.alarm_switch }}"
         }
        }
       ],
       "else": [
        {
         "if": [
          {
           "condition": "template",
           "value_template": "{{ trigger.id == 'alarm' and r.sleep != '' and is_state(r.sleep, 'on') }}"
          }
         ],
         "then": [
          {
           "action": "input_boolean.turn_off",
           "target": {
            "entity_id": "{{ r.sleep }}"
           },
           "continue_on_error": true
          }
         ]
        },
        {
         "action": "esphome.{{ r.ks }}_announce",
         "continue_on_error": true,
         "data": {
          "message": "{{ 'Time is up.' if trigger.id == 'timer' else 'Wake up, it is ' ~ now().strftime('%-I:%M') ~ '.' }}",
          "url": "",
          "volume": 0,
          "repeat": 20,
          "repeat_pause": 3,
          "chime": true,
          "chime_file": "",
          "tts_engine": "",
          "tts_language": "",
          "tts_voice": "",
          "audio_only": false
         }
        }
       ]
      }
     ]
    },
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": "silence"
      }
     ],
     "sequence": [
      {
       "if": [
        {
         "condition": "template",
         "value_template": "{{ r.ks == '' }}"
        }
       ],
       "then": [
        {
         "action": "switch.turn_off",
         "target": {
          "entity_id": "{{ r.alarm_switch }}"
         },
         "continue_on_error": true
        }
       ],
       "else": [
        {
         "action": "esphome.{{ r.ks }}_announce_stop",
         "continue_on_error": true,
         "data": {}
        }
       ]
      },
      {
       "if": [
        {
         "condition": "template",
         "value_template": "{{ is_state(armed, 'on') and as_datetime(states(alarm_time)) | as_local <= now() }}"
        }
       ],
       "then": [
        {
         "action": "input_boolean.turn_off",
         "target": {
          "entity_id": "{{ armed }}"
         }
        }
       ]
      },
      {
       "if": [
        {
         "condition": "template",
         "value_template": "{{ r.after != '' }}"
        }
       ],
       "then": [
        {
         "action": "automation.trigger",
         "target": {
          "entity_id": "{{ r.after }}"
         },
         "data": {
          "skip_condition": true
         },
         "continue_on_error": true
        }
       ]
      }
     ]
    },
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": [
        "timeout",
        "device"
       ]
      },
      {
       "condition": "template",
       "value_template": "{{ states(ringing) != 'Off' }}"
      }
     ],
     "sequence": [
      {
       "action": "input_select.select_option",
       "target": {
        "entity_id": "{{ ringing }}"
       },
       "data": {
        "option": "Off"
       }
      }
     ]
    }
   ]
  }
 ],
 "mode": "queued"
}
