{
 "id": "inspection_mode",
 "alias": "Inspection mode",
 "description": "Rental inspection privacy for the Kitchen Display and the Bedroom Echo (both Kiosk Satellite). Armed for the day by voice ('Alexa, we have an inspection today' / 'inspection mode') or by an event on calendar.p_c with 'inspection' in its title. When Cameron and Paget are both out on that day (or an inspection event starts while they are), input_boolean.inspection_mode goes on: the Immich screensaver switches to the 'Inspection' album (nature photos, no captions), corner widgets off, cameras off, mics muted, volume 0, screensaver started and Lockdown Mode on (lockdown.allow_screensaver is true on both, set in KS). The first of them home turns it off and puts everything back (volumes from input_number.inspection_*_volume; a volume already at 0 is not saved over the last good one). The Inspection mode toggle also works by hand. Added 2026-11-23.",
 "mode": "queued",
 "triggers": [
  {
   "trigger": "conversation",
   "command": [
    "(we've|we have|we've got|there's|there is) [got] an inspection [today]",
    "(the|our) inspection is today",
    "inspection (today|mode|mode on)",
    "(turn|switch) on inspection mode",
    "(start|set|arm) inspection mode",
    "(it's|it is) inspection day"
   ],
   "id": "voice_arm"
  },
  {
   "trigger": "conversation",
   "command": [
    "cancel [the] inspection [mode]",
    "inspection mode off",
    "(turn|switch) off inspection mode",
    "(there's|there is) no inspection [today]",
    "the inspection (is|has been) cancelled"
   ],
   "id": "voice_cancel"
  },
  {
   "trigger": "state",
   "entity_id": [
    "person.cameron",
    "person.paget"
   ],
   "from": "home",
   "for": {
    "minutes": 2
   },
   "id": "left"
  },
  {
   "trigger": "calendar",
   "event": "start",
   "entity_id": "calendar.p_c",
   "offset": "0:0:0",
   "id": "event_start"
  },
  {
   "trigger": "state",
   "entity_id": [
    "person.cameron",
    "person.paget"
   ],
   "to": "home",
   "id": "home"
  },
  {
   "trigger": "time",
   "at": "00:00:30",
   "id": "midnight"
  },
  {
   "trigger": "state",
   "entity_id": "input_boolean.inspection_mode",
   "to": "on",
   "id": "mode_on"
  },
  {
   "trigger": "state",
   "entity_id": "input_boolean.inspection_mode",
   "to": "off",
   "id": "mode_off"
  }
 ],
 "conditions": [],
 "variables": {
  "nobody_home": "{{ not is_state('person.cameron', 'home') and not is_state('person.paget', 'home') }}",
  "inspection_album": [
   {
    "id": "9adac809-6e7b-452b-be41-be1e4f7aa277",
    "name": "Inspection"
   }
  ],
  "family_album": [
   {
    "id": "4f88d973-4879-46a1-a44c-1b69b6439230",
    "name": "Family"
   }
  ]
 },
 "actions": [
  {
   "choose": [
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": "voice_arm"
      }
     ],
     "sequence": [
      {
       "action": "input_boolean.turn_on",
       "target": {
        "entity_id": "input_boolean.inspection_today"
       }
      },
      {
       "set_conversation_response": "Inspection mode is set for today. It starts when you've both left."
      }
     ]
    },
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": "voice_cancel"
      }
     ],
     "sequence": [
      {
       "action": "input_boolean.turn_off",
       "target": {
        "entity_id": [
         "input_boolean.inspection_today",
         "input_boolean.inspection_mode"
        ]
       }
      },
      {
       "set_conversation_response": "Inspection mode cancelled."
      }
     ]
    },
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": "left"
      },
      {
       "condition": "template",
       "value_template": "{{ nobody_home }}"
      },
      {
       "condition": "state",
       "entity_id": "input_boolean.inspection_mode",
       "state": "off"
      }
     ],
     "sequence": [
      {
       "action": "calendar.get_events",
       "target": {
        "entity_id": "calendar.p_c"
       },
       "data": {
        "start_date_time": "{{ today_at('00:00').isoformat() }}",
        "end_date_time": "{{ (today_at('00:00') + timedelta(days=1)).isoformat() }}"
       },
       "response_variable": "cal",
       "continue_on_error": true
      },
      {
       "if": [
        {
         "condition": "template",
         "value_template": "{{ is_state('input_boolean.inspection_today', 'on') or ((cal or {}).get('calendar.p_c', {}).get('events', []) | selectattr('summary', 'search', 'inspection', ignorecase=true) | list | count > 0) }}"
        }
       ],
       "then": [
        {
         "action": "input_boolean.turn_on",
         "target": {
          "entity_id": "input_boolean.inspection_mode"
         }
        }
       ]
      }
     ]
    },
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": "event_start"
      },
      {
       "condition": "template",
       "value_template": "{{ trigger.calendar_event.summary is search('inspection', ignorecase=true) }}"
      }
     ],
     "sequence": [
      {
       "action": "input_boolean.turn_on",
       "target": {
        "entity_id": "input_boolean.inspection_today"
       }
      },
      {
       "if": [
        {
         "condition": "template",
         "value_template": "{{ nobody_home }}"
        }
       ],
       "then": [
        {
         "action": "input_boolean.turn_on",
         "target": {
          "entity_id": "input_boolean.inspection_mode"
         }
        }
       ]
      }
     ]
    },
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": "home"
      }
     ],
     "sequence": [
      {
       "action": "input_boolean.turn_off",
       "target": {
        "entity_id": [
         "input_boolean.inspection_mode",
         "input_boolean.inspection_today"
        ]
       }
      }
     ]
    },
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": "midnight"
      },
      {
       "condition": "state",
       "entity_id": "input_boolean.inspection_mode",
       "state": "off"
      }
     ],
     "sequence": [
      {
       "action": "input_boolean.turn_off",
       "target": {
        "entity_id": "input_boolean.inspection_today"
       }
      }
     ]
    },
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": "mode_on"
      }
     ],
     "sequence": [
      {
       "action": "input_number.set_value",
       "target": {
        "entity_id": "input_number.inspection_kitchen_volume"
       },
       "data": {
        "value": "{% set v = states('number.kitchen_display_volume') | float(0) %}{{ v if v > 0 else states('input_number.inspection_kitchen_volume') | float(100) }}"
       }
      },
      {
       "action": "input_number.set_value",
       "target": {
        "entity_id": "input_number.inspection_echo_volume"
       },
       "data": {
        "value": "{% set v = states('number.bedroom_echo_volume') | float(0) %}{{ v if v > 0 else states('input_number.inspection_echo_volume') | float(100) }}"
       }
      },
      {
       "action": "rest_command.ks_kitchen_settings",
       "continue_on_error": true,
       "data": {
        "settings": "{{ {'screensaver.immich_album': inspection_album | to_json, 'screensaver.immich_metadata': false} }}"
       }
      },
      {
       "action": "rest_command.ks_bedroom_settings",
       "continue_on_error": true,
       "data": {
        "settings": "{{ {'screensaver.immich_album': inspection_album | to_json, 'screensaver.immich_metadata': false} }}"
       }
      },
      {
       "action": "switch.turn_on",
       "continue_on_error": true,
       "target": {
        "entity_id": [
         "switch.kitchen_display_vs_mute",
         "switch.bedroom_echo_vs_mute"
        ]
       }
      },
      {
       "action": "number.set_value",
       "continue_on_error": true,
       "target": {
        "entity_id": [
         "number.kitchen_display_volume",
         "number.bedroom_echo_volume"
        ]
       },
       "data": {
        "value": 0
       }
      },
      {
       "action": "switch.turn_off",
       "continue_on_error": true,
       "target": {
        "entity_id": [
         "switch.kitchen_display_camera_enabled",
         "switch.bedroom_echo_camera_enabled",
         "switch.kitchen_display_screensaver_widgets",
         "switch.bedroom_echo_screensaver_widgets",
         "switch.kitchen_display_screensaver_active",
         "switch.bedroom_echo_screensaver_active"
        ]
       }
      },
      {
       "delay": {
        "seconds": 3
       }
      },
      {
       "action": "switch.turn_on",
       "continue_on_error": true,
       "target": {
        "entity_id": [
         "switch.kitchen_display_screensaver",
         "switch.bedroom_echo_screensaver",
         "switch.kitchen_display_screensaver_active",
         "switch.bedroom_echo_screensaver_active"
        ]
       }
      },
      {
       "delay": {
        "seconds": 3
       }
      },
      {
       "action": "switch.turn_on",
       "continue_on_error": true,
       "target": {
        "entity_id": [
         "switch.kitchen_display_lockdown_mode",
         "switch.bedroom_echo_lockdown_mode"
        ]
       }
      },
      {
       "action": "notify.mobile_app_camerons_iphone",
       "continue_on_error": true,
       "data": {
        "title": "Inspection mode on",
        "message": "Screens show nature photos and are locked; mics muted, cameras off, volume 0. Ends when one of you gets home."
       }
      }
     ]
    },
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": "mode_off"
      }
     ],
     "sequence": [
      {
       "action": "switch.turn_off",
       "continue_on_error": true,
       "target": {
        "entity_id": [
         "switch.kitchen_display_lockdown_mode",
         "switch.bedroom_echo_lockdown_mode",
         "switch.kitchen_display_vs_mute",
         "switch.bedroom_echo_vs_mute"
        ]
       }
      },
      {
       "action": "rest_command.ks_kitchen_settings",
       "continue_on_error": true,
       "data": {
        "settings": "{{ {'screensaver.immich_album': family_album | to_json, 'screensaver.immich_metadata': true} }}"
       }
      },
      {
       "action": "rest_command.ks_bedroom_settings",
       "continue_on_error": true,
       "data": {
        "settings": "{{ {'screensaver.immich_album': family_album | to_json, 'screensaver.immich_metadata': true} }}"
       }
      },
      {
       "action": "number.set_value",
       "continue_on_error": true,
       "target": {
        "entity_id": "number.kitchen_display_volume"
       },
       "data": {
        "value": "{{ states('input_number.inspection_kitchen_volume') | float(100) }}"
       }
      },
      {
       "action": "number.set_value",
       "continue_on_error": true,
       "target": {
        "entity_id": "number.bedroom_echo_volume"
       },
       "data": {
        "value": "{{ states('input_number.inspection_echo_volume') | float(100) }}"
       }
      },
      {
       "action": "switch.turn_on",
       "continue_on_error": true,
       "target": {
        "entity_id": [
         "switch.kitchen_display_camera_enabled",
         "switch.bedroom_echo_camera_enabled",
         "switch.kitchen_display_screensaver_widgets",
         "switch.bedroom_echo_screensaver_widgets"
        ]
       }
      },
      {
       "action": "notify.mobile_app_camerons_iphone",
       "continue_on_error": true,
       "data": {
        "title": "Inspection mode off",
        "message": "Screens, mics, cameras and volume are back to normal."
       }
      }
     ]
    }
   ]
  }
 ]
}
