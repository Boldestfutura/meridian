{
 "alias": "Goodnight",
 "sequence": [
  {
   "action": "light.turn_off",
   "target": {
    "entity_id": "light.all_lights"
   }
  },
  {
   "if": [
    {
     "condition": "not",
     "conditions": [
      {
       "condition": "state",
       "entity_id": "climate.living_room",
       "state": "off"
      }
     ]
    }
   ],
   "then": [
    {
     "action": "climate.set_hvac_mode",
     "target": {
      "entity_id": "climate.living_room"
     },
     "data": {
      "hvac_mode": "off"
     }
    }
   ]
  },
  {
   "action": "media_player.turn_off",
   "target": {
    "entity_id": "media_player.living_room"
   }
  }
 ],
 "mode": "single"
}
