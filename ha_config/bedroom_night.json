{
 "id": "1784082631958",
 "alias": "Master Bedroom Night Mode - Sleep Sounds",
 "description": "9pm-7:30am while Cameron, Paget or a guest is home: input_boolean.bedroom_night_mode on, Stream Sounds looping on the bedroom Echo Show through Music Assistant at 9%. Also starts when someone gets home inside the window. Stops at 7:30am or when everyone leaves. Screen brightness and the red night clock are handled by \"Master Bedroom Echo Brightness\" from the room's light, not here.",
 "triggers": [
  {
   "trigger": "time",
   "at": "21:00:00",
   "id": "start"
  },
  {
   "trigger": "state",
   "entity_id": [
    "person.cameron",
    "person.paget"
   ],
   "to": "home",
   "id": "arrival"
  },
  {
   "trigger": "time",
   "at": "07:30:00",
   "id": "end"
  },
  {
   "trigger": "state",
   "entity_id": [
    "person.cameron",
    "person.paget"
   ],
   "to": "not_home",
   "id": "left"
  }
 ],
 "conditions": [],
 "actions": [
  {
   "choose": [
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": [
        "start",
        "arrival"
       ]
      },
      {
       "condition": "time",
       "after": "21:00:00",
       "before": "07:30:00"
      },
      {
       "condition": "state",
       "entity_id": "input_boolean.bedroom_night_mode",
       "state": "off"
      },
      {
       "condition": "or",
       "conditions": [
        {
         "condition": "state",
         "entity_id": "person.cameron",
         "state": "home"
        },
        {
         "condition": "state",
         "entity_id": "person.paget",
         "state": "home"
        },
        {
         "condition": "state",
         "entity_id": "input_boolean.guest_mode",
         "state": "on"
        }
       ]
      }
     ],
     "sequence": [
      {
       "action": "input_boolean.turn_on",
       "target": {
        "entity_id": "input_boolean.bedroom_night_mode"
       }
      },
      {
       "action": "media_player.volume_set",
       "target": {
        "entity_id": "media_player.bedroom_echo"
       },
       "data": {
        "volume_level": 0.09
       },
       "continue_on_error": true
      },
      {
       "action": "music_assistant.play_media",
       "target": {
        "entity_id": "media_player.bedroom_echo"
       },
       "data": {
        "media_id": "http://100.108.150.25:8123/local/sounds/Stream Sounds.m4a",
        "media_type": "track",
        "enqueue": "replace"
       },
       "continue_on_error": true
      },
      {
       "action": "media_player.repeat_set",
       "target": {
        "entity_id": "media_player.bedroom_echo"
       },
       "data": {
        "repeat": "one"
       },
       "continue_on_error": true
      }
     ]
    },
    {
     "conditions": [
      {
       "condition": "or",
       "conditions": [
        {
         "condition": "trigger",
         "id": "end"
        },
        {
         "condition": "and",
         "conditions": [
          {
           "condition": "trigger",
           "id": "left"
          },
          {
           "condition": "state",
           "entity_id": "person.cameron",
           "state": "not_home"
          },
          {
           "condition": "state",
           "entity_id": "person.paget",
           "state": "not_home"
          },
          {
           "condition": "state",
           "entity_id": "input_boolean.guest_mode",
           "state": "off"
          }
         ]
        }
       ]
      },
      {
       "condition": "state",
       "entity_id": "input_boolean.bedroom_night_mode",
       "state": "on"
      }
     ],
     "sequence": [
      {
       "action": "media_player.media_stop",
       "target": {
        "entity_id": "media_player.bedroom_echo"
       },
       "continue_on_error": true
      },
      {
       "action": "media_player.repeat_set",
       "target": {
        "entity_id": "media_player.bedroom_echo"
       },
       "data": {
        "repeat": "off"
       },
       "continue_on_error": true
      },
      {
       "action": "input_boolean.turn_off",
       "target": {
        "entity_id": "input_boolean.bedroom_night_mode"
       }
      }
     ]
    }
   ]
  }
 ],
 "mode": "queued"
}
