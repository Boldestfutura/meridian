{
  "id": "pip_talk",
  "alias": "Pip - Talked To",
  "description": "Talking to either voice screen counts as attention for Pip (input_datetime.pip_last_talk).",
  "mode": "single",
  "triggers": [
    {
      "trigger": "state",
      "entity_id": [
        "assist_satellite.kitchen_tablet_va",
        "assist_satellite.bedroom_echo_va"
      ],
      "to": "processing"
    }
  ],
  "conditions": [],
  "actions": [
    {
      "action": "input_datetime.set_datetime",
      "target": {
        "entity_id": "input_datetime.pip_last_talk"
      },
      "data": {
        "timestamp": "{{ now().timestamp() }}"
      }
    }
  ]
}