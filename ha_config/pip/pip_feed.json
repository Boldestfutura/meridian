{
  "alias": "Pip: feed",
  "icon": "mdi:food-apple",
  "description": "Feed Pip.",
  "mode": "single",
  "sequence": [
    {
      "action": "input_datetime.set_datetime",
      "target": {
        "entity_id": "input_datetime.pip_last_fed"
      },
      "data": {
        "timestamp": "{{ now().timestamp() }}"
      }
    },
    {
      "action": "homeassistant.update_entity",
      "target": {
        "entity_id": [
          "sensor.pip_mood",
          "sensor.pip_food"
        ]
      }
    }
  ]
}