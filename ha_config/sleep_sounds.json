{
 "id": "1794010000001",
 "alias": "Master Bedroom Sleep Sounds",
 "description": "Plays Stream Sounds on the bedroom Echo Show at 9%, looping, while input_boolean.bedroom_night_mode (\"Sleep Sounds\") is on, and stops it when it goes off. The switch is flipped by \"Master Bedroom Night Mode - Sleep Sounds\" (9pm-7:30am) or by hand from the Sleep Sounds tile.",
 "triggers": [
  {
   "trigger": "state",
   "entity_id": "input_boolean.bedroom_night_mode",
   "from": "off",
   "to": "on",
   "id": "on"
  },
  {
   "trigger": "state",
   "entity_id": "input_boolean.bedroom_night_mode",
   "from": "on",
   "to": "off",
   "id": "off"
  }
 ],
 "conditions": [],
 "actions": [
  {
   "choose": [
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": "on"
      }
     ],
     "sequence": [
      {
       "action": "media_player.volume_set",
       "target": {
        "entity_id": "media_player.bedroom_echo"
       },
       "data": {
        "volume_level": 0.09
       },
       "continue_on_error": true
      },
      {
       "action": "music_assistant.play_media",
       "target": {
        "entity_id": "media_player.bedroom_echo"
       },
       "data": {
        "media_id": "http://100.108.150.25:8123/local/sounds/Stream Sounds.m4a",
        "media_type": "track",
        "enqueue": "replace"
       },
       "continue_on_error": true
      },
      {
       "action": "media_player.repeat_set",
       "target": {
        "entity_id": "media_player.bedroom_echo"
       },
       "data": {
        "repeat": "one"
       },
       "continue_on_error": true
      }
     ]
    },
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": "off"
      }
     ],
     "sequence": [
      {
       "action": "media_player.media_stop",
       "target": {
        "entity_id": "media_player.bedroom_echo"
       },
       "continue_on_error": true
      },
      {
       "action": "media_player.repeat_set",
       "target": {
        "entity_id": "media_player.bedroom_echo"
       },
       "data": {
        "repeat": "off"
       },
       "continue_on_error": true
      }
     ]
    }
   ]
  }
 ],
 "mode": "restart"
}
