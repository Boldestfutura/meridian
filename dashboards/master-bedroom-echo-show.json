              "voice": "bedroom",
              "voice_satellite": "assist_satellite.bedroom_echo_va",
              "clock": "bedroom",
              "nowplaying": "media_player.bedroom_echo",
              "nowplaying_return": 40,
              "scheme": "sun.sun",
              "washer": {
                "entity": "input_select.washing_machine",
                "started": "input_datetime.washing_machine_started",
                "alert": "input_boolean.washing_machine_alert"
              },
              "warnings": true,
              "morning": true
            }
          ]
        }
      ]
