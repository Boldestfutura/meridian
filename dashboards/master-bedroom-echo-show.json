              "name": "All Lights",
              "icon": "mdi:lightbulb-group",
              "grid_options": {
                "columns": 12,
                "rows": 3
              }
            },
            {
              "type": "custom:meridian-large-button",
              "entity": "input_boolean.bedroom_night_mode",
